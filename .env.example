OIDC_ISSUER_URI=http://localhost:8180/realms/agrosphere
OIDC_AUDIENCE=agrosphere-api
# Optional container-accessible JWKS; issuer validation is still required.
OIDC_JWK_SET_URI=http://localhost:8180/realms/agrosphere/protocol/openid-connect/certs
ESTATE_SERVICE_URL=http://localhost:8081
SPATIAL_SERVICE_URL=http://localhost:8082
CORS_ALLOWED_ORIGINS=http://localhost:4200
GATEWAY_CONNECT_TIMEOUT=2s
GATEWAY_READ_TIMEOUT=10s
GATEWAY_RATE_LIMIT=120
TRACING_SAMPLE_PROBABILITY=0.1
